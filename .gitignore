# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtualenvs / CUDA scratch
.venv/
venv/
env/
brain-streaming/server/.cuda_home/

# Local runtime output
*.log
*.bin

# Unity generated
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Ll]ogs/
*.csproj
*.sln
*.user

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Unity per-user editor state
[Uu]serSettings/

# Large local volume data (T1 raw is 26 MB; not needed for streaming work)
brain-streaming/unity/BrainVolumeSRD/Assets/StreamingAssets/T1/*.raw
brain-streaming/unity/BrainVolumeSRD/Assets/StreamingAssets/T1/*.raw.meta

# Exported fused-volume levels (hb02_L7/L5/L4 .raw) -- regenerate with
# server/tools/zarr_level_to_raw.py or copy manually to the SRD machine.
brain-streaming/unity/BrainVolumeSRD/Assets/StreamingAssets/Fused/*.raw
brain-streaming/unity/BrainVolumeSRD/Assets/StreamingAssets/Fused/*.raw.meta

# Unity crash-recovery scene copies
**/Assets/_Recovery/
**/Assets/_Recovery.meta
brain-streaming/unity/BrainVolumeSRD/Assets/StreamingAssets/Bricks/hb02_fused/
# IIP slide tiles (IipSectionOverlay local copy, Brain > IIP > Pre-download slide tiles)
brain-streaming/unity/BrainVolumeSRD/Assets/StreamingAssets/IIP/
brain-streaming/unity/BrainVolumeSRD/Assets/StreamingAssets/IIP.meta
brain-streaming/unity/BrainVolumeSRD/.vs
# showcase videos (BrainShowcase F10)
brain-streaming/unity/BrainVolumeSRD/Recordings/

# Player builds (one exe folder per presentation scene, ~46 GB each with the bricks)
brain-streaming/unity/BrainVolumeSRD/Builds/
brain-streaming/unity/BrainVolumeSRD/Build_V1/

# Density / probability maps (.npz; astrocyte_density 22 MB, fib_probability 2 MB) -- copy manually,
# like the .raw volumes. StreamingAssets/Npz/ is the copy that ships in builds.
brain-streaming/unity/npz_files/
brain-streaming/unity/BrainVolumeSRD/Assets/StreamingAssets/Npz/*.npz
brain-streaming/unity/BrainVolumeSRD/Assets/StreamingAssets/Npz/*.npz.meta
# BFI / MRI NIfTI volumes (BFI_in_MRI_2.nii 200 MB) -- copy manually; StreamingAssets/Nifti/ ships in builds
brain-streaming/unity/bfi/
brain-streaming/unity/BrainVolumeSRD/Assets/StreamingAssets/Nifti/*.nii
brain-streaming/unity/BrainVolumeSRD/Assets/StreamingAssets/Nifti/*.nii.meta
