# Multi-block DGX Brain Streaming server -- A100 / CuPy (CUDA 12) image.
# Same server as Dockerfile, but with GPU processing + server-side resample.
# Requires the NVIDIA Container Toolkit on the host and `--gpus all` at run.
#
# Build from the brain-streaming/ directory (build context = brain-streaming/):
#   docker build -t brain-streaming:gpu -f server/Dockerfile.gpu .
#   docker run --rm --gpus all -p 8010:8010 brain-streaming:gpu
#
# Falls back to CPU automatically if the GPU is unavailable at runtime.
FROM nvidia/cuda:12.2.2-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /srv/server

COPY server/requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt && \
    pip3 install --no-cache-dir cupy-cuda12x==13.3.0

COPY server /srv/server
COPY client /srv/client

EXPOSE 8010

ENTRYPOINT ["python3", "app_zarr.py", "--host", "0.0.0.0", "--port", "8010"]
CMD ["--min-level", "3"]
